# Скопируйте:  cp .env.example .env && chmod 600 .env

# Токен WB только на чтение (Статистика + Аналитика + Контент по необходимости).
WB_TOKEN=

# Куда класть готовую HTML-страницу после прогона.
SITE_DIR=/var/www/wb-report/wb
PAGE_NAME=index.html
# Для кампании «цены под цель» обычно:
# OP_PAGE_NAME=wb-op.html

# Часовой пояс расчёта
TZ=Europe/Moscow

# --- Google Таблицы (мост Apps Script), если читаете остатки фулла / юнитку / план ---
# GS_URL=
# GS_TOKEN=
# AVAIL_SHEET_ID=
# AVAIL_SHEET_NAME=РассчетПоставки
# AVAIL_HEADER_ROW=5
# AVAIL_ART_COL=B
# Названия колонок остатка фулла через | (ищутся по тексту шапки):
# AVAIL_FF_HEADERS=Остаток на ФФ 1|Остаток на ФФ 2
# AVAIL_TOWB_HEADER=Товары в пути на склад ВБ
# AVAIL_FF_MIN=20
# AVAIL_WB_MIN=20

# --- Отметки менеджера («Поставил» / «Своя цена» / «Не ставлю») ---
# FB_KEY=сгенерируйте-длинную-строку
# FB_KEY_REQUIRED=1
# FB_HOST=127.0.0.1
# FB_PORT=8092

# --- Опционально: маржа из финансового сервиса ---
# FIN_DB=/opt/mp-finance/data.sqlite
# PM_SHEET_ID=
# PM_SHEET_NAME=ДействияПоАртикулам
